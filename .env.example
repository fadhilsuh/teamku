MOVON_ENV=development
MOVON_DATABASE_URL=postgresql+asyncpg://movon:movon@postgres:5432/movon
MOVON_CORS_ORIGINS=http://localhost:3000
# Dipakai apps/web untuk mem-proxy /api/* ke FastAPI. Dibutuhkan pada waktu
# BUILD, bukan runtime: Next membakukan rewrite ini ke routes-manifest.json.
MOVON_API_ORIGIN=http://127.0.0.1:8000
MOVON_APP_BASE_URL=http://localhost:3000
MOVON_SESSION_COOKIE_SECURE=false
# Google Calendar OAuth (create a Web application client in Google Auth Platform)
# MOVON_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# MOVON_GOOGLE_CLIENT_SECRET=...
# MOVON_GOOGLE_REDIRECT_URI=https://api.<domain>/api/v1/settings/calendar/google/callback
# Transactional email. console = log + in-memory outbox (no network).
# MOVON_MAIL_PROVIDER=resend
# MOVON_RESEND_API_KEY=re_...
# MOVON_MAIL_FROM=Teamku <noreply@movoncreative.dev>
